local function _dx(t)
    local k = 1449
    local o = {}
    for i = 1, #t do
        local e = t[i]
        local b = bit32.bxor(e, (k % 256))
        b = (b - (k % 251)) % 256
        o[i] = string.char(b)
        k = (k * 33 + e + 7) % 1000003
    end
    return table.concat(o)
end
