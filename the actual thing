local function layoutChrome(px, py, W, H)
    shell.Position = Vector2.new(px - 2, py - 2); shell.Size = Vector2.new(W + 4, H + 4); shell.Visible = true
    panel.Position = Vector2.new(px, py); panel.Size = Vector2.new(W, H); panel.Visible = true
    border.Position = Vector2.new(px, py); border.Size = Vector2.new(W, H); border.Thickness = 1; border.Visible = true
    header.Position = Vector2.new(px, py); header.Size = Vector2.new(W, T.titleH); header.Visible = true
    accent.Position = Vector2.new(px, py + T.titleH); accent.Size = Vector2.new(W, 2); accent.Visible = true
    titleT.Text = NAME .. "   v" .. VERSION
    titleT.Position = Vector2.new(px + T.pad, py + (T.titleH - T.fTitle) * 0.5)
    titleT.Visible = true
    verT.Visible = false

    closeT.Text = "X"
    closeT.Position = Vector2.new(math.floor(px + W - 16), math.floor(py + T.titleH * 0.5))
    closeT.Visible = true

    local mbx, mby, mw, mh = math.floor(px + W - 44), math.floor(py + T.titleH * 0.5), 6, 5
    local apexY = mby + mh * (2 * anim.minA - 1)
    local baseY = mby + mh * (1 - 2 * anim.minA)
    minTri.PointA = Vector2.new(mbx, apexY)
    minTri.PointB = Vector2.new(mbx - mw, baseY)
    minTri.PointC = Vector2.new(mbx + mw, baseY)
    minTri.Visible = true
end

local function layoutTabs(px, py, W, dt)
    local tw = (W - T.pad * 2) / #TABS
    local ty = py + T.titleH + 10
    local mx, my = mouse.X, mouse.Y
    local activeX = px + T.pad
    local hoverX, hovering = nil, false
    for i, name in ipairs(TABS) do
        local tx = px + T.pad + (i - 1) * tw
        local active = state.activeTab == name
        tabTxt[i].Text = name
        tabTxt[i].Color = active and C.text or C.sub
        tabTxt[i].Position = Vector2.new(tx + tw * 0.5, ty + T.tabH * 0.5)
        tabTxt[i].Visible = true
        if active then activeX = tx end
        if not dragging and inRect(mx, my, tx, ty, tw, T.tabH) then hoverX = tx; hovering = true end
        hits[#hits + 1] = { kind = "tab", name = name, x = tx, y = ty, w = tw, h = T.tabH }
    end

    anim.tabHoverA = approach(anim.tabHoverA, hovering and 1 or 0, dt)
    if hovering then
        anim.tabHoverX = (anim.tabHoverA < 0.05) and hoverX or approach(anim.tabHoverX, hoverX, dt, T.tabSpeed)
    end
    if anim.tabHoverA > 0.02 then
        tabHover.Position = Vector2.new(anim.tabHoverX + 4, ty + 3)
        tabHover.Size = Vector2.new(tw - 8, T.tabH - 6)
        tabHover.Transparency = anim.tabHoverA * 0.45
        tabHover.Visible = true
    else
        tabHover.Visible = false
    end

    anim.tabX = approach(anim.tabX, activeX, dt, dragging and T.dragFollow or T.tabSpeed)
    tabInd.Position = Vector2.new(anim.tabX + 8, ty + T.tabH - 3)
    tabInd.Size = Vector2.new(tw - 16, 3)
    tabInd.Visible = true
end

