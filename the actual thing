-- The game clones a "FullBagNotification" directly under CoinBags when a bag fills.
-- The template lives under the inner script, so a direct child means a live "full" event.
local function coinBagFull()
    local bags = resolveCoinBags()
    if not bags then return false end
    local ok, n = pcall(function() return bags:FindFirstChild("FullBagNotification") end)
    return ok and n ~= nil
end

-- A round is "active" while a murderer exists (with a short grace vs detection flicker).
-- When it ends (lobby / next round), the coin bag resets, so we can resume farming.
local function isRoundActive()
    if state.roles.murder or state.selfRole == "Murderer" then return true end
    return state.murderSeenAt ~= nil and (now() - state.murderSeenAt) < 2.5
end

-- Park idle under the map (or just above the floor on solid maps) without disabling
-- auto coins, so AFK farmers keep the feature on and auto-resume next round.
local function parkUnder(root, myPos)
    local refY = autoFloorY or myPos.Y
    tpRoot(root, Vector3.new(myPos.X, safeHoverY(myPos.X, myPos.Z, refY), myPos.Z))
end

task.spawn(function()
    while state.running do
        if state.features.autoCoins then
            local char = lp.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                setNoclip(char, true); noclipOn = true
                local myPos = readPos(root) or state.originPos
                -- Bag-full state machine: latch when the bag fills, clear when the round
                -- ends (bag resets). While full, stay parked but keep auto coins ON.
                if not state.bagFull then
                    if coinBagFull() then
                        state.bagFull = true
                        pcall(function() notify(NAME, "Coin bag full - parked (auto coins still on)", 3) end)
                    end
                elseif not isRoundActive() then
                    state.bagFull = false
                end
                if state.bagFull then
                    autoTarget = nil
                    parkUnder(root, myPos)
                    task.wait(T.auto.idleWait)
                else
                if not autoTarget then
                    autoTarget = nearestCoin(myPos, true) or nearestCoin(myPos, false)
                end
                if autoTarget then
                    local cpos = autoTarget.pos
                    local cpart = autoTarget.part
                    autoFloorY = cpos.Y
                    local hx, hz = cpos.X - myPos.X, cpos.Z - myPos.Z
                    local horiz = math.sqrt(hx * hx + hz * hz)
                    if horiz <= T.auto.reachDist then
                        -- Dwell on the coin and CONFIRM collection (TouchInterest disappears).
                        -- Jiggle in/out to re-fire the Touched contact so the game registers it.
                        -- Do not assume success (that caused the go-back-and-forth loop).
                        local deadline = now() + T.auto.collectTimeout
                        local flip = false
                        while state.features.autoCoins and now() < deadline do
                            if flip then
                                tpRoot(root, cpos)
                            else
                                tpRoot(root, cpos + Vector3.new(0, T.auto.jiggle, 0))
                            end
                            flip = not flip
                            task.wait(T.auto.collectDwell)
                            if not coinAlive(cpart) then break end
                        end
                        visited[coinKey(cpos)] = now()
                        autoTarget = nil
                        local mp = readPos(root) or myPos
                        hideUnder(root, mp.X, mp.Z)
                        task.wait(T.auto.tick)
                    else
                        local d = math.min(T.auto.stepDist, horiz)
                        local nx = myPos.X + (hx / horiz) * d
                        local nz = myPos.Z + (hz / horiz) * d
                        tpRoot(root, Vector3.new(nx, safeHoverY(nx, nz, cpos.Y), nz))
                        task.wait(T.auto.tick)
                    end
                else
                    hideUnder(root, myPos.X, myPos.Z)
                    task.wait(T.auto.idleWait)
                end
                end
            else
                task.wait(0.2)
            end
        else
            if noclipOn then pcall(function() setNoclip(lp.Character, false) end); noclipOn = false end
            autoTarget = nil
            visited = {}
            state.bagFull = false
            task.wait(0.2)
        end
    end
end)

-- Auto knife: undetected. Injects real input (equip key + left click) so the game's
-- own KnifeClient fires the kill remotes; the physical swing lands the hit. No hybrid mode.
local knifeCd = 0
task.spawn(function()
    while state.running do
        if state.features.autoKnife and state.selfRole == "Murderer" and not state.menuOpen then
            local char = lp.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local myPos = root and readPos(root)
            if myPos then
                local best, bestD = nil, T.knife.range
                local s = state.roles.sheriff
                if s then
                    local d = (s.rootPos - myPos).Magnitude
                    if d <= bestD then bestD = d; best = s end
                end
                for _, inn in ipairs(state.roles.innocents) do
                    local d = (inn.rootPos - myPos).Magnitude
                    if d <= bestD then bestD = d; best = inn end
                end
                if best and (now() - knifeCd) >= T.knife.cd then
                    if not char:FindFirstChild("Knife") then
                        pcall(function() keypress(T.knife.equipKey) end)
                        task.wait(0.03)
                        pcall(function() keyrelease(T.knife.equipKey) end)
                        task.wait(0.12)
                    end
                    pcall(function()
                        root.CFrame = CFrame.lookAt(myPos, Vector3.new(best.rootPos.X, myPos.Y, best.rootPos.Z))
                    end)
                    pcall(function() mouse1click() end)
                    knifeCd = now()
                end
            end
        end
