local function mk(kind, list, z)
    local d = Drawing.new(kind)
    d.Visible = false
    if d.Transparency ~= nil then d.Transparency = 1 end
    if z then d.ZIndex = z end
    list[#list + 1] = d
    return d
end
local function square(list, color, z, filled, corner)
    local d = mk("Square", list, z)
    d.Filled = filled ~= false
    d.Color = color
    d.Size = Vector2.new(1, 1)
    if corner then d.Corner = corner end
    return d
end
local function text(list, size, color, z, center, outline)
    local d = mk("Text", list, z)
    d.Size = size; d.Color = color; d.Center = center or false
    d.Outline = outline == true
    pcall(function() d.Font = FONT end)
