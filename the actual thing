local function threatNear(pos, dist)
    local m, s = state.roles.murder, state.roles.sheriff
    if m and (m.rootPos - pos).Magnitude <= dist then return true end
    if s and (s.rootPos - pos).Magnitude <= dist then return true end
    return false
end

local visited = {}
local function coinKey(pos)
    return math.floor(pos.X) .. "," .. math.floor(pos.Y) .. "," .. math.floor(pos.Z)
end

local function coinAlive(part)
    local ok, r = pcall(function()
        return part.Parent ~= nil and part:FindFirstChild("TouchInterest") ~= nil
    end)
    return ok and r == true
end

local function nearestCoin(fromPos, avoidThreats)
    local best, bestD = nil, math.huge
    local t = now()
    for _, c in ipairs(state.coins) do
        if coinAlive(c.part) then
            local blocked = avoidThreats and threatNear(c.pos, T.auto.threatDist)
            if not blocked then
                local v = visited[coinKey(c.pos)]
                if not v or (t - v) > T.auto.visitCooldown then
                    local d = (c.pos - fromPos).Magnitude
                    if d < bestD then bestD = d; best = c end
                end
            end
        end
    end
    return best
end

local function tpRoot(root, pos)
    pcall(function() root.Position = pos end)
    pcall(function() root.Velocity = Vector3.new(0, 0, 0) end)
end

local autoTarget = nil
local autoFloorY = nil

-- Map-adaptive vertical safety. hugDepth below a THIN floor is open air (stealthy),
-- but below a THICK floor it is inside solid geometry -> "invalid position" kick.
-- So: find the local floor by a downward ray, then only dive under when an upward ray
-- from the candidate point confirms open space; otherwise hover just above the floor.
local function rcParams()
    local ok, rp = pcall(function()
        local p = RaycastParams.new()
        p.FilterType = Enum.RaycastFilterType.Exclude
        local filt = {}
        if lp.Character then filt[#filt + 1] = lp.Character end
        if state.coinContainer then filt[#filt + 1] = state.coinContainer end
        p.FilterDescendantsInstances = filt
        return p
    end)
    return ok and rp or nil
end

local function safeHoverY(x, z, refY)
    local ok, y = pcall(function()
        local rp = rcParams()
        if not rp then return refY + T.auto.liftAbove end
        local down = Workspace:Raycast(Vector3.new(x, refY + 8, z), Vector3.new(0, -500, 0), rp)
        if not down then return refY + T.auto.liftAbove end
        local floorY = down.Position.Y
        local candUnder = floorY - T.auto.hugDepth
        local up = Workspace:Raycast(Vector3.new(x, candUnder, z), Vector3.new(0, T.auto.hugDepth + 3, 0), rp)
        if up and up.Instance then return candUnder end
        return floorY + T.auto.liftAbove
    end)
    if ok and type(y) == "number" then return y end
    return refY + T.auto.liftAbove
end

local function hideUnder(root, x, z)
    if autoFloorY then tpRoot(root, Vector3.new(x, safeHoverY(x, z, autoFloorY), z)) end
end

local function resolveCoinBags()
