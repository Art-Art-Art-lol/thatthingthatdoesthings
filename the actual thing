local function layoutSlider(px, py, W, item, dt)
    local bw = W - T.pad * 2
    local bx = px + T.pad
    local trackY, trackH = py + 24, 14

    slider.label.Text = item.fmt(item.get())
    slider.label.Position = Vector2.new(bx, py + 2); slider.label.Visible = true

    local actualT = math.clamp((item.get() - item.min) / (item.max - item.min), 0, 1)
    local shown = anim.sliders[item.key]
    if shown == nil then shown = actualT end
    shown = approach(shown, actualT, dt, T.sliderSpeed)
    anim.sliders[item.key] = shown

    local r = 8
    local kx = bx + r + shown * (bw - 2 * r)
    slider.bar.Position = Vector2.new(bx, trackY); slider.bar.Size = Vector2.new(bw, trackH); slider.bar.Visible = true
    slider.fill.Position = Vector2.new(bx, trackY); slider.fill.Size = Vector2.new(math.max(trackH, kx - bx), trackH); slider.fill.Visible = true
    slider.knob.Position = Vector2.new(kx, trackY + trackH * 0.5); slider.knob.Visible = true

    hits[#hits + 1] = { kind = "slider", item = item, sx = bx + r, sw = bw - 2 * r, x = bx, y = trackY - 4, w = bw, h = trackH + 8 }
end

local function layoutButton(px, py, W, item)
    local bx, bw = px + T.pad, W - T.pad * 2
    button.box.Position = Vector2.new(bx, py); button.box.Size = Vector2.new(bw, T.rowH); button.box.Visible = true
    button.border.Position = Vector2.new(bx, py); button.border.Size = Vector2.new(bw, T.rowH); button.border.Thickness = 1; button.border.Visible = true
    button.label.Text = item.label
    button.label.Position = Vector2.new(bx + bw * 0.5, py + T.rowH * 0.5); button.label.Visible = true
    hits[#hits + 1] = { kind = "button", cb = item.cb, x = bx, y = py, w = bw, h = T.rowH }
end

local function drawRipples()
    for i = 1, T.ripplePool do ripplePool[i].Visible = false end
    local i = 1
    while i <= #ripples do
        local r = ripples[i]
        local t = (now() - r.start) / T.rippleLife
        if t >= 1 then
            table.remove(ripples, i)
        else
            local c = ripplePool[i]
            if c then
                local ease = 1 - (1 - t) * (1 - t)
                c.Radius = math.max(1, ease * T.rippleMax)
                c.Position = Vector2.new(r.x, r.y)
                c.Transparency = 0.5 * (1 - t)
                c.Visible = true
            end
            i = i + 1
        end
    end
end

local function layoutContent(px, py, W, mx, my, dt)
    resetControls()
    local y = py + T.titleH + T.tabH + 22
    local usedRow = 0
    local hoveredY = nil
    for _, item in ipairs(itemsFor(state.activeTab)) do
        if item.kind == "toggle" then
            usedRow = usedRow + 1
            if inRect(mx, my, px + T.pad * 0.5, y, W - T.pad, T.rowH) then hoveredY = y end
            layoutToggle(rows[usedRow], item, px, y, W, dt)
            y = y + T.rowH + 6
        elseif item.kind == "label" then
            usedRow = usedRow + 1
            layoutLabel(rows[usedRow], item, px, y)
            y = y + T.rowH + 6
        elseif item.kind == "slider" then
            layoutSlider(px, y, W, item, dt)
            y = y + 50
        elseif item.kind == "button" then
            layoutButton(px, y, W, item)
            y = y + T.rowH + 6
        end
    end

    anim.hoverA = approach(anim.hoverA, hoveredY and 1 or 0, dt)
    if hoveredY then
        anim.hoverY = (anim.hoverA < 0.05) and hoveredY or approach(anim.hoverY, hoveredY, dt, T.tabSpeed)
    end
    if anim.hoverA > 0.02 then
        hoverBar.Position = Vector2.new(px + T.pad * 0.5, anim.hoverY)
        hoverBar.Size = Vector2.new(W - T.pad, T.rowH)
        hoverBar.Transparency = 0.35 + anim.hoverA * 0.45
        hoverBar.Visible = true
    end
end

local function layoutMenu(dt)
    hits = {}
    local px = state.menuPos.X
    local restY = state.menuPos.Y
    local offY = cam.ViewportSize.Y + 20
    local py = offY + (restY - offY) * anim.openA
    curDrawY = py
    local W = T.menuW
    anim.minA = approach(anim.minA, state.minimized and 1 or 0, dt, T.minimizeSpeed)
    anim.menuH = approach(anim.menuH, state.minimized and T.titleH or T.menuH, dt, T.minimizeSpeed)
    layoutChrome(px, py, W, anim.menuH)
    if anim.menuH > T.titleH + T.tabH + 30 then
        layoutTabs(px, py, W, dt)
        layoutContent(px, py, W, mouse.X, mouse.Y, dt)
        drawRipples()
    else
        for i = 1, #TABS do tabTxt[i].Visible = false end
        tabHover.Visible = false; tabInd.Visible = false
        resetControls()
        for i = 1, T.ripplePool do ripplePool[i].Visible = false end
    end
end

local function handleMenuInput()
    local mx, my = mouse.X, mouse.Y
    local down = ismouse1pressed()
    local px, py = state.menuPos.X, curDrawY
    local W = T.menuW

    if down and not prevMouse then
        if inRect(mx, my, px + W - 28, py + 6, 28, 28) then prevMouse = down; unload(); return end
        if inRect(mx, my, px + W - 58, py + 6, 26, 28) then prevMouse = down; state.minimized = not state.minimized; return end
        local consumed = false
        for _, h in ipairs(hits) do
            if inRect(mx, my, h.x, h.y, h.w, h.h) then
                if h.kind == "tab" then
                    state.activeTab = h.name; saveConfig(); spawnRipple(mx, my); consumed = true
                elseif h.kind == "toggle" then
                    h.set(not h.get()); anim.pulses[h.key] = now(); spawnRipple(mx, my); consumed = true
                elseif h.kind == "button" then
                    spawnRipple(mx, my); h.cb(); return
                elseif h.kind == "slider" then
                    activeSlider = h; consumed = true
                end
                break
            end
        end
        if not consumed and inRect(mx, my, px, py, W - 62, T.titleH) then
            dragging = true; dragOffset = Vector2.new(mx - px, my - py)
        end
    end

    if not down then
        if dragging or activeSlider then saveConfig() end
        dragging = false; activeSlider = nil
    end
    prevMouse = down

    if dragging and down then
        state.menuPos = Vector2.new(mx - dragOffset.X, my - dragOffset.Y)
    end
    if activeSlider and down then
        local item = activeSlider.item
        local t = math.clamp((mx - activeSlider.sx) / activeSlider.sw, 0, 1)
        item.set(item.min + t * (item.max - item.min))
    end
end

unload = function()
    if not state.running then return end
    state.running = false
    pcall(function() renderConn:Disconnect() end)
    pcall(function() setNoclip(lp.Character, false) end)
    saveConfig()
    for _, d in ipairs(worldDraw) do pcall(function() d.Visible = false end); pcall(function() d:Remove() end) end
    for _, d in ipairs(menuDraw) do pcall(function() d.Visible = false end); pcall(function() d:Remove() end) end
    pcall(function() _G.MM2ESP = nil end)
    pcall(function() notify(NAME, "unloaded", 2) end)
    print("[Kyrev] unloaded")
end
_G.MM2ESP.unload = unload
_G.MM2ESP.state = state

loadConfig()

local wasOpen = false
renderConn = RunService.RenderStepped:Connect(function(dt)
    if not state.running then return end
    dt = dt or 0.016
    pcall(drawWorld)

    local keyDown = iskeypressed(KEY_MENU)
    if keyDown and not prevMenuKey then state.menuOpen = not state.menuOpen end
    prevMenuKey = keyDown

    anim.openA = approach(anim.openA, state.menuOpen and 1 or 0, dt, T.openSpeed)
    if state.menuOpen or anim.openA > 0.02 then
        pcall(function() layoutMenu(dt) end)
        if state.menuOpen then pcall(handleMenuInput) end
        wasOpen = true
    elseif wasOpen then
        hideMenu(); wasOpen = false
    end
end)

pcall(function() notify(NAME, "loaded v" .. VERSION .. "  -  menu: END", 4) end)
print("[Kyrev] loaded v" .. VERSION .. "  |  menu: END")

end)
