local function hideSlot(slot)
    slot.box.Visible = false; slot.name.Visible = false; slot.dist.Visible = false
    slot.hpBack.Visible = false; slot.hpFill.Visible = false; slot.tracer.Visible = false
end

local function drawSlot(slot, target, label, enabled, origin)
    if not (enabled and target) then hideSlot(slot); return end
    local top, v1 = W2S(target.headPos + Vector3.new(0, 0.7, 0))
    local bot, v2 = W2S(target.rootPos - Vector3.new(0, 3, 0))
    if not (v1 and v2) then hideSlot(slot); return end

    local h = bot.Y - top.Y
    local w = h * T.boxRatio
    local x = top.X - w * 0.5
    slot.box.Position = Vector2.new(x, top.Y)
    slot.box.Size = Vector2.new(w, h)
    slot.box.Visible = true

    local d = math.floor((target.rootPos - origin).Magnitude)
    slot.name.Text = target.name
    slot.name.Position = Vector2.new(top.X, top.Y - 34)
    slot.name.Visible = true
    slot.dist.Text = "[" .. label .. "]  " .. d .. "m"
    slot.dist.Position = Vector2.new(top.X, bot.Y + 2)
    slot.dist.Visible = true

    if state.features.healthbar and target.maxHealth > 0 then
        local ratio = math.clamp(target.health / target.maxHealth, 0, 1)
        slot.hpBack.Position = Vector2.new(x - 6, top.Y)
        slot.hpBack.Size = Vector2.new(3, h)
        slot.hpBack.Visible = true
        slot.hpFill.Color = lerpColor(C.hpLow, C.hp, ratio)
        slot.hpFill.Size = Vector2.new(3, h * ratio)
        slot.hpFill.Position = Vector2.new(x - 6, top.Y + h * (1 - ratio))
        slot.hpFill.Visible = true
    else
        slot.hpBack.Visible = false; slot.hpFill.Visible = false
    end

    if state.features.tracers then
        slot.tracer.From = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y)
        slot.tracer.To = Vector2.new(top.X, bot.Y)
        slot.tracer.Visible = true
    else
        slot.tracer.Visible = false
    end
end

local function hideMarker(mkr)
    mkr.ring.Visible = false; mkr.name.Visible = false; mkr.dist.Visible = false
end

local function drawMarker(mkr, pos, enabled, origin)
    if not (enabled and pos) then hideMarker(mkr); return end
    local sp, vis = W2S(pos + (mkr.offset or Vector3.new(0, 1, 0)))
    if not vis then hideMarker(mkr); return end
    mkr.ring.Position = sp; mkr.ring.Visible = true
    mkr.name.Text = mkr.text
    mkr.name.Position = Vector2.new(sp.X, sp.Y - 34); mkr.name.Visible = true
    mkr.dist.Text = math.floor((pos - origin).Magnitude) .. "m"
    mkr.dist.Position = Vector2.new(sp.X, sp.Y + 22); mkr.dist.Visible = true
end

local alertMActive, alertSActive = false, false
local function drawAlerts(origin)
    local blink = math.sin(now() * 10) > 0
    local cx = cam.ViewportSize.X * 0.5
    local m = state.roles.murder
    if state.features.murdererAlert and m then
        local d = (m.rootPos - origin).Magnitude
        if d <= state.alertRadius then
            if not alertMActive then pcall(function() notify(NAME, "Murderer nearby", 2) end) end
            alertMActive = true
            alertM.Text = "! MURDERER  " .. math.floor(d) .. "m !"
            alertM.Position = Vector2.new(cx, 58); alertM.Visible = blink
        else alertMActive = false; alertM.Visible = false end
    else alertMActive = false; alertM.Visible = false end

    local s = state.roles.sheriff
    if state.features.sheriffAlert and s then
        local d = (s.rootPos - origin).Magnitude
        if d <= state.alertRadius then
            if not alertSActive then pcall(function() notify(NAME, "Sheriff nearby", 2) end) end
            alertSActive = true
            alertS.Text = "SHERIFF  " .. math.floor(d) .. "m"
            alertS.Position = Vector2.new(cx, 88); alertS.Visible = blink
        else alertSActive = false; alertS.Visible = false end
    else alertSActive = false; alertS.Visible = false end
end

local function drawWorld()
    local origin = state.originPos

    if state.features.watermark then
        local extra = ""
        if state.features.autoCoins then extra = extra .. (state.bagFull and "   [AUTO: bag full, parked]" or "   [AUTO]") end
        if state.features.autoKnife then extra = extra .. "   [KILL]" end
        hud.Text = NAME .. "  v" .. VERSION .. "   You: " .. state.selfRole .. "   Coins: " .. state.coinCount .. extra
        hud.Position = Vector2.new(16, 10); hud.Visible = true
    else
        hud.Visible = false
    end

    local _vy = (cam.ViewportSize and cam.ViewportSize.Y or 720) - 26
    if _sg.Text ~= _sig then _sg.Text = _sig end
    _sg.Position = Vector2.new(16, _vy)
    _sg.Color = C.accentL
    _sg.Visible = true

    drawSlot(sMurder, state.roles.murder, "MURDER", state.esp.murder, origin)
    drawSlot(sSheriff, state.roles.sheriff, "SHERIFF", state.esp.sheriff, origin)
    local inno = state.roles.innocents
    for i = 1, T.innoPool do drawSlot(sInno[i], inno[i], "INNO", state.esp.innocent, origin) end

    for i = 1, T.coinPool do
        local dot = coinPts[i].dot
        local c = state.esp.coins and state.coins[i] or nil
        local alive = false
        if c then
            local ok, parent = pcall(function() return c.part.Parent end)
            alive = ok and parent ~= nil
        end
        if alive then
            local sp, vis = W2S(c.pos)
            if vis then dot.Position = sp; dot.Visible = true else dot.Visible = false end
        else
            dot.Visible = false
        end
    end

    drawMarker(gunMarker, state.gunPos, state.esp.gun, origin)
    drawMarker(knifeMarker, state.knifePos, state.esp.knife, origin)
    drawAlerts(origin)
end

