local function roleOf(plr)
    local char = plr.Character
    if char then
        if char:FindFirstChild("Knife") then return "Murderer" end
        if char:FindFirstChild("Gun") then return "Sheriff" end
    end
    local bp = plr:FindFirstChildOfClass("Backpack")
    if bp then
        if bp:FindFirstChild("Knife") then return "Murderer" end
        if bp:FindFirstChild("Gun") then return "Sheriff" end
    end
    return "Innocent"
end

local function readPos(inst)
    local ok, p = pcall(function() return inst.Position end)
    if ok and typeof(p) == "Vector3" then return p end
    return nil
end

local function snapshotPlayer(plr)
    local char = plr.Character
    local head = char and char:FindFirstChild("Head")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (head and root) then return nil end
    local hp, rp = readPos(head), readPos(root)
    if not (hp and rp) then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local health, maxHealth = 0, 0
    if hum then
        local okh = pcall(function() health = hum.Health; maxHealth = hum.MaxHealth end)
        if not okh then health, maxHealth = 0, 0 end
    end
    return { name = plr.Name, headPos = hp, rootPos = rp, health = health, maxHealth = maxHealth }
end

local function collectRoles()
    local m, s, inno = nil, nil, {}
    local myId = lp.UserId
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.UserId ~= myId then
            local snap = snapshotPlayer(plr)
            local dead = snap and snap.maxHealth > 0 and snap.health <= 0
            if snap and not dead then
                local role = roleOf(plr)
                if role == "Murderer" then m = snap
                elseif role == "Sheriff" then s = snap
                else inno[#inno + 1] = snap end
            end
        end
    end
    state.roles.murder = m
    state.roles.sheriff = s
    state.roles.innocents = inno
end

local function resolveCoinContainer()
    local cc = state.coinContainer
    if cc then
        local ok, parent = pcall(function() return cc.Parent end)
        if ok and parent then return cc end
    end
    local direct = Workspace:FindFirstChild("CoinContainer")
    if direct then state.coinContainer = direct; return direct end
    for _, child in ipairs(Workspace:GetChildren()) do
        local found = child:FindFirstChild("CoinContainer")
        if found then state.coinContainer = found; return found end
    end
    state.coinContainer = nil
    return nil
end

local function collectCoins()
    local coins = {}
    local cc = resolveCoinContainer()
    if cc then
        for _, child in ipairs(cc:GetChildren()) do
            if child.Name == "Coin_Server" and child:FindFirstChild("TouchInterest") then
                local p = readPos(child)
                if p then coins[#coins + 1] = { part = child, pos = p } end
            end
        end
    end
    state.coins = coins
    state.coinCount = #coins
    if #coins == 0 then state.coinContainer = nil end
end

local function gunPartPos(tool)
    local part = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    return part and readPos(part) or nil
end

local function findGroundGun()
    for _, v in ipairs(Workspace:GetChildren()) do
        if v.ClassName == "Tool" and v.Name == "Gun" then
            local p = gunPartPos(v)
            if p then return p end
        elseif v.ClassName == "Folder" then
            for _, c in ipairs(v:GetChildren()) do
                if c.ClassName == "Tool" and c.Name == "Gun" then
                    local p = gunPartPos(c)
                    if p then return p end
                end
            end
        end
    end
    return nil
end

local function updateGunDrop()
    local s = state.roles.sheriff
    -- A murderer exists if another player is the murderer OR the local player is
    -- (collectRoles excludes self, so state.roles.murder is nil when WE are the murderer).
    local murdererPresent = (state.roles.murder ~= nil) or (state.selfRole == "Murderer")
    if murdererPresent then state.murderSeenAt = now() end
    local roundActive = murdererPresent or (state.murderSeenAt and (now() - state.murderSeenAt) < 2.5)
    if not roundActive then
        state.gunDropPos = nil
        state.lastSheriffPos = nil
        state.sheriffSeen = false
        return
    end
    if s then
        state.lastSheriffPos = s.rootPos
        state.sheriffSeen = true
        state.gunDropPos = nil
    elseif state.sheriffSeen and state.lastSheriffPos then
        state.gunDropPos = state.lastSheriffPos
    end
end

