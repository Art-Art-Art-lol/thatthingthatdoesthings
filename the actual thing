local function updSlider()
    local px,py=panelPos.X,panelPos.Y; local bx=px+12
    local t=math.clamp((updateRate-RATE_MIN)/(RATE_MAX-RATE_MIN),0,1)
    sFill.Size=Vector2.new(math.max(8,t*SLIDER_W),8)
    sFill.Position=Vector2.new(bx,py+SLIDER_Y)
    sKnob.Position=Vector2.new(bx+t*SLIDER_W-7,py+SLIDER_Y-3)
    sLbl.Text=string.format("Update: %.2fs",updateRate)
end

local function rp()
    local px,py=panelPos.X,panelPos.Y
    dBg.Position=Vector2.new(px,py); dTBg.Position=Vector2.new(px,py)
    dBor.Position=Vector2.new(px,py); dAcc.Position=Vector2.new(px,py)
    dSepT.Position=Vector2.new(px,py+TH)
    dXBox.Position=Vector2.new(px+BTN_PAD,py+BTN_PAD)
    dXTxt.Position=Vector2.new(px+BTN_PAD+BTN_SZ*.5+.3,py+BTN_PAD+(BTN_SZ-14)*.5+4.5)
    dTi.Position=Vector2.new(px+BTN_PAD+BTN_SZ+10,py+8)
    dHint.Position=Vector2.new(px+10,py+PH-16)
    for _,r in ipairs(ROWCFG) do
        rD[r.key].dot.Position=Vector2.new(px+12,py+r.dy)
        rD[r.key].lbl.Position=Vector2.new(px+30,py+r.dy)
    end
    sBg.Position=Vector2.new(px+12,py+SLIDER_Y)
    sLbl.Position=Vector2.new(px+12,py+SLIDER_Y-17)
    sLblL.Position=Vector2.new(px+12,py+SLIDER_Y+11)
    sLblR.Position=Vector2.new(px+PW-26,py+SLIDER_Y+11)
    updSlider()
    lastPanelPos=panelPos
end
rp()

local function iB(mx,my,x,y,w,h) return mx>=x and mx<=x+w and my>=y and my<=y+h end
local function syncDots() for k,d in pairs(rD) do d.dot.Color=espEnabled[k] and C.G or C.R end end
local function setUI(v)
    uiVisible=v; for _,d in ipairs(ALL) do d.Visible=v end
    if not v then
        gC.Visible=false; gL.Visible=false; gD.Visible=false
        for _,s in ipairs(sI) do s.box.Visible=false; s.tag.Visible=false end
        sM.box.Visible=false; sM.tag.Visible=false; sS.box.Visible=false; sS.tag.Visible=false
    end
end

local conn
local function ej()
    running=false; pcall(function() conn:Disconnect() end)
    for _,d in ipairs(ALL) do pcall(function() d:Remove() end) end
    print(_off())
end

local function hasItem(plr,name)
    local c=plr.Character; if c and c:FindFirstChild(name) then return true end
    local b=plr:FindFirstChildOfClass("Backpack"); return b and b:FindFirstChild(name)~=nil
end
local function getMyRole()
    if hasItem(lp,"Knife") then return "Murderer" end
    if hasItem(lp,"Gun") then return "Sheriff" end
    return "Innocent"
end
local function detectRoles()
    local m,s,inno=nil,nil,{}
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=lp then
            local char=plr.Character
            local head=char and char:FindFirstChild("Head")
            local root=char and char:FindFirstChild("HumanoidRootPart")
            if head and root then
                local d={name=plr.Name,head=head,root=root}
                if hasItem(plr,"Knife") then m=d
                elseif hasItem(plr,"Gun") then s=d
                else inno[#inno+1]=d end
            end
        end
    end
    return m,s,inno
end
local function isInPlayer(tool)
    for _,plr in ipairs(Players:GetPlayers()) do
        if tool:IsDescendantOf(plr) then return true end
    end
end

task.spawn(function()
    while running do
        local m,s,inno=detectRoles()
        roleData.murder=m; roleData.sheriff=s; roleData.innocents=inno
        if getMyRole()=="Murderer" and not espEnabled.innocent then
            espEnabled.innocent=true; syncDots()
        end
        task.wait(updateRate)
    end
end)

task.spawn(function()
    while running do
        local found=false
        for _,v in ipairs(ws:GetDescendants()) do
            if v.ClassName=="Tool" and v.Name=="Gun" and not isInPlayer(v) then
                local h=v:FindFirstChild("Handle")
                if not h then for _,c in ipairs(v:GetChildren()) do
                    if c.ClassName=="Part" or c.ClassName=="MeshPart" then h=c; break end
                end end
                if h then
                    gunState="dropped"; droppedGunPart=h
                    local ok,pos=pcall(function() return h.Position end)
                    if ok then gunDropPos=pos end
                    found=true; break
                end
            end
        end
        if not found and gunState=="dropped" then
            local any=false
            for _,plr in ipairs(Players:GetPlayers()) do
                if hasItem(plr,"Gun") then any=true; break end
            end
            if any then gunState="picked"; gunDropPos=nil; droppedGunPart=nil end
        end
        task.wait(1)
    end
end)

local mouse=lp:GetMouse()

local function rndr(slot,t,label,enabled,myRoot)
    if not enabled or not t then slot.box.Visible=false; slot.tag.Visible=false; return end
    local top,v1=WorldToScreen(t.head.Position+Vector3.new(0,0.7,0))
    local bot,v2=WorldToScreen(t.root.Position-Vector3.new(0,3,0))
    if v1 and v2 then
        local h=bot.Y-top.Y; local w=h*.5
        slot.box.Position=Vector2.new(top.X-w*.5,top.Y); slot.box.Size=Vector2.new(w,h); slot.box.Visible=true
        local d=myRoot and math.floor((t.root.Position-myRoot.Position).Magnitude) or 0
        slot.tag.Text="["..label.."] "..t.name.."  "..d.."m"
        slot.tag.Position=Vector2.new(top.X,top.Y-20); slot.tag.Visible=true
    else slot.box.Visible=false; slot.tag.Visible=false end
end

conn=RunService.RenderStepped:Connect(function()
    local mx,my=mouse.X,mouse.Y; local m1=ismouse1pressed(); local eN=iskeypressed(35)
    local px,py=panelPos.X,panelPos.Y

    if eN and not prevEnd then setUI(not uiVisible) end
    prevEnd=eN

    if m1 and not prevM1 then
        if iB(mx,my,px+BTN_PAD,py+BTN_PAD,BTN_SZ,BTN_SZ) then ej(); return end
        if uiVisible then
            if iB(mx,my,px+BTN_PAD+BTN_SZ+2,py,PW-(BTN_PAD+BTN_SZ+4),TH) then
                dragging=true; dragOff=Vector2.new(mx-px,my-py)
            elseif iB(mx,my,px+10,py+SLIDER_Y-8,PW-20,28) then
                sliderDrag=true
            else
                for _,r in ipairs(ROWCFG) do
                    if iB(mx,my,px+8,py+r.dy-4,PW-16,22) then
                        espEnabled[r.key]=not espEnabled[r.key]; syncDots()
                    end
                end
            end
        end
    end
    if not m1 then dragging=false; sliderDrag=false end
    prevM1=m1

    if dragging and m1 then
        local np=Vector2.new(mx-dragOff.X,my-dragOff.Y)
        if not lastPanelPos or math.abs(np.X-lastPanelPos.X)>0.1 or math.abs(np.Y-lastPanelPos.Y)>0.1 then
            panelPos=np; rp()
        end
    end
    if sliderDrag and m1 then
        local t=math.clamp((mx-(panelPos.X+12))/SLIDER_W,0,1)
        local nr=RATE_MIN+t*(RATE_MAX-RATE_MIN)
        if math.abs(nr-updateRate)>0.005 then updateRate=nr; updSlider() end
    end

    if not uiVisible then return end
    local myChar=lp.Character; local myRoot=myChar and myChar:FindFirstChild("HumanoidRootPart")
    rndr(sM,roleData.murder,"MURDER",espEnabled.murder,myRoot)
    rndr(sS,roleData.sheriff,"SHERIFF",espEnabled.sheriff,myRoot)
    local inno=roleData.innocents
    for i=1,IPOOL do rndr(sI[i],inno[i],"INNO",espEnabled.innocent,myRoot) end

    if gunDropPos then
        if droppedGunPart then
            local ok,pos=pcall(function() return droppedGunPart.Position end)
            if ok and pos then gunDropPos=pos end
        end
        local sp,vis=WorldToScreen(gunDropPos+Vector3.new(0,1,0))
        if vis then
            gC.Position=sp; gC.Visible=true
            gL.Position=Vector2.new(sp.X,sp.Y-30); gL.Visible=true
            local d=myRoot and math.floor((gunDropPos-myRoot.Position).Magnitude) or 0
            gD.Text=d.."m"; gD.Position=Vector2.new(sp.X,sp.Y+24); gD.Visible=true
        else gC.Visible=false; gL.Visible=false; gD.Visible=false end
    else gC.Visible=false; gL.Visible=false; gD.Visible=false end
end)

