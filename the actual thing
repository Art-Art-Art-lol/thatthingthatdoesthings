local function sq(f,col,sz,t,cn,th)
    local s=Drawing.new("Square"); s.Filled=f; s.Color=col; s.Size=sz
    s.Visible=false; s.Transparency=t or 1
    if cn then s.Corner=cn end; if th then s.Thickness=th end; return s
end
local function tx(t,sz,col,ce,o)
    local d=Drawing.new("Text"); d.Text=t; d.Size=sz; d.Color=col
    d.Center=ce or false; d.Outline=o or false; d.Visible=false; return d
end

local function mkSlot(col)
    local b=sq(false,col,Vector2.new(1,1),1,nil,1)
    local t=tx("",15,col,true,true); return {box=b,tag=t}
end
