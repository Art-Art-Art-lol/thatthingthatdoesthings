local function layoutToggle(row, item, px, py, W, dt)
    row.label.Text = item.label
    row.label.Position = Vector2.new(px + T.pad, centerY(py, T.fRow))
    row.label.Visible = true

    local tw, th = 46, 22
    local tx = px + W - tw - T.pad
    local ty = py + (T.rowH - th) * 0.5
    local on = item.get()
    local a = anim.toggles[item.key] or (on and 1 or 0)
    a = approach(a, on and 1 or 0, dt, T.toggleSpeed)
    anim.toggles[item.key] = a

    row.track.Position = Vector2.new(tx, ty); row.track.Size = Vector2.new(tw, th)
    row.track.Color = lerpColor(C.track, C.accent, a); row.track.Visible = true

    local pulse = 0
    local pv = anim.pulses[item.key]
    if pv then
        local pt = (now() - pv) / 0.3
        if pt < 1 then pulse = math.sin(pt * math.pi) * 2 end
    end
    row.knob.Radius = 9 + pulse
    row.knob.Position = Vector2.new(tx + 11 + a * (tw - 22), ty + th * 0.5)
    row.knob.Visible = true

    hits[#hits + 1] = { kind = "toggle", set = item.set, get = item.get, key = item.key, x = px + T.pad * 0.5, y = py, w = W - T.pad, h = T.rowH }
end

local function layoutLabel(row, item, px, py)
    row.label.Text = (type(item.label) == "function") and item.label() or item.label
